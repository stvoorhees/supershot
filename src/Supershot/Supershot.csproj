<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms><!-- NotifyIcon (tray) + System.Drawing capture -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Supershot</RootNamespace>
    <AssemblyName>Supershot</AssemblyName>
    <Version>0.1.0</Version>
    <ApplicationIcon>..\..\assets\Supershot.ico</ApplicationIcon>
    <!-- DPI awareness is set in app.manifest (WPF-primary app); silence the WinForms-oriented nudge. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <!-- Ship the web editor next to the exe and load it via a WebView2 virtual host. -->
  <ItemGroup>
    <Content Include="..\..\editor\**\*.*" Link="editor\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\Supershot.ico" Link="Supershot.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
